{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OwO Agent",
  "version": "0.1.0",
  "identifier": "com.owo.agent",
  "build": {
    "frontendDist": "../../web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OwO Agent 工作台",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:*"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://example.com/owo/updates/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQyNDJBODZCOUQ5RDA4MDAKUldRQUNKMmRhNmhDMHR5VVhDcDA1YUdlMzhpS2xPRnVGbHA2UHBqR1NZVloxUkx3VENGUE5QSGEK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "externalBin": ["binaries/owo-agent"],
    "resources": {
      "../../../tools/rg/rg.exe": "tools/rg/rg.exe",
      "../../../tools/rg/manifest.json": "tools/rg/manifest.json",
      "../../../tools/rg/COPYING": "tools/rg/COPYING",
      "../../../tools/rg/LICENSE-MIT": "tools/rg/LICENSE-MIT",
      "../../../tools/rg/UNLICENSE": "tools/rg/UNLICENSE",
      "../../../tools/rg/README.md": "tools/rg/README.md"
    },
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "installMode": "currentUser"
      }
    }
  }
}
